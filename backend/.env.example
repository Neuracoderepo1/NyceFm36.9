# ── APP ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── DATABASE ─────────────────────────────────────────
DATABASE_URL=postgres://postgres:devpassword@localhost:5432/nycefm

# ── REDIS ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── SESSIONS ─────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_a_long_random_value

# ── OBJECT STORAGE (Phase 5B / Supabase-compatible) ──
# Backend-only service credentials. Never expose these to browser clients.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nycefm-media

# ── OBJECT STORAGE (Phase 2) ─────────────────────────
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── AI PROVIDERS (Phase 3) ───────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── TTS (Phase 3) ─────────────────────────────────────
TTS_PROVIDER=
TTS_API_KEY=

# ── STRIPE (Phase 5) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── EMAIL (Phase 4/5) ─────────────────────────────────
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# ── STREAMING (Phase 2) ───────────────────────────────
ICECAST_HOST=
ICECAST_PORT=
ICECAST_SOURCE_PASSWORD=
CDN_BASE_URL=

# ── MEDIA / STREAMING 2B ─────────────────────────────
MEDIA_STORAGE_PATH=./storage/media
STREAM_STORAGE_PATH=./storage/streams
MAX_UPLOAD_BYTES=104857600
PUBLIC_BASE_URL=http://localhost:3000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_PROCESSOR_INTERVAL_MS=2000
BROADCAST_WORKER_ENABLED=false
BROADCAST_WORKER_INTERVAL_MS=1000
STREAM_AUDIO_BITRATE=128k
HLS_SEGMENT_SECONDS=4
HLS_LIST_SIZE=8
# Optional external input for generic HLS relay mode.
STREAM_INPUT_URL=
BROADCAST_WATCHDOG_INTERVAL_MS=5000
BROADCAST_WATCHDOG_TIMEOUT_MS=15000
BROADCAST_SCHEDULE_HORIZON_MINUTES=30

# ── PRODUCTION MEDIA / AI ─────────────────────────────
# Set to supabase when the private nycefm-media bucket is the source of truth.
MEDIA_STORAGE_PROVIDER=local
AI_PROVIDER=local
ANTHROPIC_MODEL=claude-sonnet-5
AI_WORKER_ENABLED=false
AI_WORKER_INTERVAL_MS=15000

# ── PAYMENTS ──────────────────────────────────────────
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=https://YOUR-DOMAIN/?payment=success
STRIPE_CANCEL_URL=https://YOUR-DOMAIN/?payment=cancelled
# Example: STRIPE_PRICE_VIP=price_...
STRIPE_PRICE_VIP=
# Webhook HMAC verification is built into the API; keep the secret server-side.
STRIPE_WEBHOOK_VERIFIER=enabled
